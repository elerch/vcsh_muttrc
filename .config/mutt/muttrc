# Folder jumps. Needed because <Space>/<mailbox-cycle> only visits mailboxes
# with new mail, so it can never reach Sent or Trash.
macro index,pager ,i "<change-folder>+Inbox<enter>"         "go to Inbox"
macro index,pager ,r "<change-folder>+Inbox/.Drafts<enter>" "go to Drafts"
macro index,pager ,s "<change-folder>+Inbox/.Sent<enter>"   "go to Sent"
macro index,pager ,j "<change-folder>+Inbox/.Junk<enter>"   "go to Junk"
macro index,pager ,x "<change-folder>+Inbox/.Trash<enter>"  "go to Trash"

# Sweep deleted messages into the Trash.
#
# d only marks a message: maildir_trash=yes turns the delete into a 'T' flag
# rename, so it stays put and shows red, and $trash is inert. ,X lifts the
# guard for exactly one <sync-mailbox>, which is when $trash does the actual
# move into =Inbox/.Trash, then puts the guard straight back.
#
# It also sets delete=yes for the same window. That is deliberate: a
# confirmation prompt fired from inside a macro competes with the macro's own
# remaining keystrokes, and testing showed that leaves the restore unreliable.
# Leaving maildir_trash off is a far worse failure than an unconfirmed sweep,
# because the syncthing race it guards against destroys mail outright (it sets
# Email.purge, which bypasses $trash). The d presses are the confirmation, and
# a mistaken ,X is recoverable since everything lands in .Trash.
#
# Inside .Trash itself deletes are real, per the $trash docs, so ,X doubles as
# "empty the trash".
macro index ,X "<enter-command>set maildir_trash=no delete=yes<enter><sync-mailbox><enter-command>set maildir_trash=yes delete=ask-yes<enter>" "move deleted messages to Trash"


