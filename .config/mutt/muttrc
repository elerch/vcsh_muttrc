set message_id_format = '<%Y%02m%02d%02H%02M%02S.G%c%p@%f>'
set use_from = yes
set envelope_from = yes
set timeout = 300
timeout-hook 'exec sync-mailbox'

# We won't use imap here - Maildir instead
# My mailboxes
# set folder = 'imaps://imap.gmail.com:993'
set mbox_type=Maildir
set folder = "~/Mail/lerch.org"
set spoolfile = '+Inbox'
set ssl_force_tls = yes
set sendmail = "sendemail"

# Sent/Drafts/Trash live under Inbox/, not in the [Gmail]/ tree that mbsync
# pulls down.
set record = '=Inbox/.Sent'
set trash = '=Inbox/.Trash'
set postponed = '=Inbox/.Drafts'

# Declared mailboxes. Feeds the browser's mailbox-list view (c then ? then
# <Tab>), <Space> cycling at the <change-folder> prompt, and the sidebar.
#
# <Space>/<mailbox-cycle> only visits mailboxes with NEW MAIL, so it never
# reaches Sent or Trash. Use the ,i/,r/,s/,j/,x macros further down instead.
#
# <Tab> at the folder prompt is NOT mailbox-name completion, it is plain
# filename completion -- and it is rebound to complete-query below, so ^T is
# the path-completion key in this config.
named-mailboxes "Inbox"  "+Inbox" \
                "Drafts" "+Inbox/.Drafts" \
                "Sent"   "+Inbox/.Sent" \
                "Junk"   "+Inbox/.Junk" \
                "Trash"  "+Inbox/.Trash"

# Deletes become a maildir 'T' flag rename, never an unlink().
# Guards against neomutt marking messages deleted when syncthing
# renames files underneath a long-running session. This makes the
# $trash setting above inert -- see trash_append() in mx.c -- which
# is intentional; $trash cannot protect against this failure mode
# because the code path that causes it sets Email.purge.
set maildir_trash = yes

# Safety net: re-assert the guard on every folder change, so an interrupted
# macro can never leave maildir_trash off for long.
folder-hook . 'set maildir_trash=yes'

# Where to put the stuff
set header_cache     = ~/.mutt/cache/headers # store headers
set message_cachedir = ~/.mutt/cache/bodies  # store bodies
# set certificate_file = ~/.mutt/certificates  # store certs (touch file)


